# --- Required ---
PORT=8000
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=change-me-to-a-long-random-value
SESSION_SECRET=change-me-to-a-different-long-random-value

# --- Drona email-only exception (see docs/drona/email-exception-handoff.md) ---
# Explicitly approved exception: profile.email only, no Drona session/nonce
# verification. Local sign-in and the old container bridge are disabled in
# this mode. Fails closed unless every flag below is set exactly as shown.
AUTH_STRATEGY=drona
DRONA_EMAIL_EXCEPTION_ENABLED=true
DRONA_MAPPING_REVIEWED=true
DRONA_ENVIRONMENT=aws
DRONA_ORGANIZATION_ID=42d930ea-56ba-4d92-a4d8-a79c490e4e13

# --- CORS ---
# Comma-separated list of origins allowed to call this API cross-origin.
# Leave unset to allow every origin (fine for local dev; not for a real
# split deploy).
CORS_ORIGINS=https://dsgvjfnd2ao8v.cloudfront.net

# --- Optional features (each degrades gracefully if unset) ---
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
# SMTP_ALLOWED_HOSTS=
# SMTP_ALLOW_PRIVATE_HOSTS=
# LOG_LEVEL=info

# --- Evidence/attachment file storage ---
# objectStorage.ts currently talks to Replit's own local sidecar
# (127.0.0.1:1106) via PRIVATE_OBJECT_DIR -- that sidecar does not exist on
# EC2. Evidence upload/download will fail until this is replaced with a real
# backend (S3, or a local-disk provider like L0-L1-Platform's). Not solved
# by this env file -- flagging it here so it isn't missed.
# PRIVATE_OBJECT_DIR=
