@@ -23466,7 +23466,7 @@ WHERE
         FROM
           pg_stat_user_indexes idx
         LEFT JOIN
-          pg_constraint con ON con.conindid = idx.indexrelid
+          pg_constraint con ON con.conindid = idx.indexrelid AND con.contype IN ('p', 'u', 'x')
         WHERE idx.relname = '${tableName}' and schemaname = '${tableSchema}'
         group by index_name, table_name,schemaname, generated_by_constraint;`
             );
@@ -75272,7 +75272,11 @@ var pushSchema = async (imports, drizzleInstance, schemaFilters, tablesFilter, e
   );
   const db = {
     query: async (query, params) => {
-      const res = await drizzleInstance.execute(sql.raw(query));
+      // Keep introspection bindings (notably composite-PK schema/table names).
+      // This workspace uses node-postgres; sql.raw alone drops these values.
+      const res = params?.length
+        ? await drizzleInstance.$client.query(query, params)
+        : await drizzleInstance.execute(sql.raw(query));
       return res.rows;
     }
   };
